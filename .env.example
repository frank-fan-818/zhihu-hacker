# Copy to .env locally. Never commit real secrets.
ZHIHU_ACCESS_SECRET=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# Must match the registered HTTPS callback exactly.
ZHIHU_OAUTH_REDIRECT_URI=
# Required for OAuth; example: https://your-domain.example
APP_ORIGIN=
# Shared key-value store for login state. Required on Serverless: without it the
# OAuth state lives in one instance and the callback landing on another fails.
# Upstash Redis REST endpoint and token; locally these may stay empty.
# Vercel's Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead,
# which this app also accepts (these two take priority when both are present).
SESSION_STORE_URL=
SESSION_STORE_TOKEN=
# Optional key namespace, defaults to cd:
SESSION_STORE_PREFIX=
# Optional. Defaults to data/app.sqlite; on Vercel it defaults to /tmp/app.sqlite,
# which is per-instance and lost on cold start.
SQLITE_FILE=
HOST=127.0.0.1
PORT=4317
