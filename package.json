{
  "name": "cognitive-debugger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "diagnose": "node --env-file-if-exists=.env src/diagnose.mjs",
    "db:doctor": "node --env-file-if-exists=.env src/db-doctor.mjs",
    "quota": "node --env-file-if-exists=.env src/diagnose.mjs --quota",
    "test": "node --test test/*.test.mjs",
    "test:serial": "node --test --test-isolation=none test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "verify:prompt": "node --env-file-if-exists=.env scripts/verify-check-prompt.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.7"
  },
  "devDependencies": {
    "redis": "^6.2.1"
  }
}
